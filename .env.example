# ==================== BOT CONFIG ====================
BOT_TOKEN=
BOT_USERNAME=HINATA_GROUP_CHAT_bot
BOT_NAME=Sofiya

# ==================== GROQ AI (chatbot + moderation) ====================
# Get keys from https://console.groq.com/keys  (extra keys = auto failover)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional model overrides
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ==================== MONGODB ====================
MONGO_URI=

# ==================== ADMIN ====================
OWNER_ID=8441236350
SUDO_USERS=8441236350,7553434931
LOGGER_GROUP_ID=

# ==================== MISC ====================
LOG_LEVEL=info
PING_IMAGE_URL=https://files.catbox.moe/yt6gy9.png
PORT=3000

# ==================== PREMIUM TELEGRAM EMOJI ====================
# Telegram needs custom-emoji IDs; addemoji pack links are catalogued in code.
# Format: alias=id,alias=id
PREMIUM_EMOJI_IDS=
AI_GAMES_ENABLED=true
